<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ report_date }} 下注報告</title>
<style>
  :root {
    --bg: #0b0f14;
    --panel: #121821;
    --panel-2: #171f2b;
    --line: #273244;
    --text: #e7edf5;
    --muted: #8a97aa;
    --blue: #56a8e8;
    --green: #48c78e;
    --red: #f87171;
    --amber: #f3c969;
    --violet: #a78bfa;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Segoe UI", "Noto Sans TC", system-ui, sans-serif;
    line-height: 1.55;
  }
  a { color: var(--blue); text-decoration: none; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 22px 18px 42px; }
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .back { color: var(--muted); font-size: 0.86rem; }
  h1 { margin: 4px 0 0; font-size: clamp(1.35rem, 3vw, 2rem); color: var(--blue); }
  .sub { color: var(--muted); font-size: 0.88rem; }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 650;
  }
  .section { margin-top: 24px; }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    margin-bottom: 12px;
  }
  h2 { margin: 0; font-size: 1.03rem; color: var(--blue); }
  .hint { color: var(--muted); font-size: 0.82rem; }
  .metrics {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
  }
  .metric, .panel, .strategy {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .metric { padding: 14px; }
  .metric-k { color: var(--muted); font-size: 0.75rem; }
  .metric-v { margin-top: 4px; font-size: 1.22rem; font-weight: 800; }
  .green { color: var(--green); }
  .red { color: var(--red); }
  .amber { color: var(--amber); }
  .blue { color: var(--blue); }
  .violet { color: var(--violet); }
  .panel { overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  th, td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
  th { color: var(--muted); background: var(--panel-2); font-weight: 650; }
  tr:last-child td { border-bottom: 0; }
  .badge {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 0.73rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .badge-win { color: var(--green); background: rgba(72,199,142,0.13); }
  .badge-loss { color: var(--red); background: rgba(248,113,113,0.13); }
  .badge-void { color: var(--muted); background: rgba(138,151,170,0.13); }
  .badge-info { color: var(--blue); background: rgba(86,168,232,0.13); }
  .tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .tab {
    border: 0;
    border-right: 1px solid var(--line);
    background: var(--panel);
    color: var(--text);
    min-height: 62px;
    padding: 10px;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }
  .tab:last-child { border-right: 0; }
  .tab.active { background: var(--panel-2); box-shadow: inset 0 -3px 0 var(--blue); }
  .tab-name { display: block; font-weight: 800; }
  .tab-sub { display: block; color: var(--muted); font-size: 0.76rem; margin-top: 2px; }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  .strategy { padding: 14px; }
  .strategy-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 14px;
  }
  .mini {
    padding: 10px;
    background: var(--panel-2);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
  }
  .mini-k { color: var(--muted); font-size: 0.72rem; }
  .mini-v { margin-top: 3px; font-weight: 800; }
  .parlay-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .parlay {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel-2);
    padding: 12px;
  }
  .parlay-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
  .parlay-title { font-weight: 800; overflow-wrap: anywhere; }
  .parlay-meta { color: var(--muted); font-size: 0.78rem; margin-top: 4px; }
  .amount { text-align: right; font-size: 1.05rem; font-weight: 850; color: var(--blue); white-space: nowrap; }
  .potential { color: var(--muted); font-size: 0.75rem; text-align: right; }
  .legs { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
  .leg {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 7px;
    background: rgba(11,15,20,0.45);
    color: var(--muted);
    font-size: 0.8rem;
  }
  .leg strong { color: var(--text); font-weight: 700; }
  .empty { padding: 28px 14px; text-align: center; color: var(--muted); }
  .summary-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding: 12px 14px;
    border-radius: 8px;
    background: var(--panel-2);
    border: 1px solid rgba(255,255,255,0.05);
    font-size: 0.9rem;
  }
  .prediction-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .prediction-card { padding: 14px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; }
  .prediction-name { font-weight: 800; margin-bottom: 10px; }
  .prediction-game { padding: 10px; border-radius: 8px; background: var(--panel-2); border: 1px solid rgba(255,255,255,0.05); margin-top: 8px; }
  .prediction-title { font-weight: 750; font-size: 0.84rem; overflow-wrap: anywhere; }
  .prediction-score { color: var(--blue); font-weight: 800; margin-top: 4px; }
  .prediction-meta { color: var(--muted); font-size: 0.74rem; margin-top: 5px; line-height: 1.45; }
  footer {
    margin-top: 34px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.76rem;
    text-align: center;
  }
  @media (max-width: 900px) {
    .metrics { grid-template-columns: repeat(3, 1fr); }
    .strategy-summary, .parlay-grid, .prediction-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .wrap { padding: 16px 12px 32px; }
    .topbar, .section-head { align-items: flex-start; flex-direction: column; }
    .metrics { grid-template-columns: repeat(2, 1fr); }
    .tabs { grid-template-columns: 1fr; }
    .tab { border-right: 0; border-bottom: 1px solid var(--line); }
    .tab:last-child { border-bottom: 0; }
    .parlay-head, .summary-line { flex-direction: column; align-items: stretch; }
    .amount, .potential { text-align: left; }
    table { font-size: 0.78rem; }
    th, td { padding: 8px; }
  }
</style>
</head>
<body>
<main class="wrap">
  <header class="topbar">
    <div>
      <a class="back" href="index.html">返回首頁</a>
      <h1>{{ report_date }} 下注報告</h1>
      <div class="sub">正式規則：只做 2 關以上串關；候選足夠時每日固定 5 關 NT$10</div>
    </div>
    <a class="btn" href="backtest-2026-04-01.html">查看回測</a>
  </header>

  <section class="section">
    <div class="metrics">
      <div class="metric">
        <div class="metric-k">目前本金</div>
        <div class="metric-v blue">NT${{ "{:,.0f}".format(bankroll_current) }}</div>
      </div>
      <div class="metric">
        <div class="metric-k">昨日盈虧</div>
        <div class="metric-v {% if yesterday_pnl >= 0 %}green{% else %}red{% endif %}">
          {% if yesterday_pnl >= 0 %}+{% endif %}NT${{ "{:,.0f}".format(yesterday_pnl) }}
        </div>
      </div>
      <div class="metric">
        <div class="metric-k">累積報酬率</div>
        <div class="metric-v {% if bankroll_roi >= 0 %}green{% else %}red{% endif %}">
          {% if bankroll_roi >= 0 %}+{% endif %}{{ "{:.1f}".format(bankroll_roi) }}%
        </div>
      </div>
      <div class="metric">
        <div class="metric-k">距高點回撤</div>
        <div class="metric-v {% if bankroll_dd > 20 %}red{% elif bankroll_dd > 10 %}amber{% else %}green{% endif %}">
          -{{ "{:.1f}".format(bankroll_dd) }}%
        </div>
      </div>
      <div class="metric">
        <div class="metric-k">單關命中率</div>
        <div class="metric-v">停用</div>
      </div>
      <div class="metric">
        <div class="metric-k">串關命中率</div>
        <div class="metric-v violet">{{ "{:.1f}".format(win_rate_parlay) }}%</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>昨日成績</h2>
      <div class="hint">{{ yesterday_date }}</div>
    </div>
    {% if yesterday_results %}
    <div class="panel">
      <table>
        <thead>
          <tr><th>#</th><th>下注內容</th><th>球種</th><th>賠率</th><th>下注額</th><th>結果</th><th>盈虧</th></tr>
        </thead>
        <tbody>
          {% for r in yesterday_results %}
          <tr>
            <td>{{ loop.index }}</td>
            <td>{{ r.bet_label }}</td>
            <td>{{ r.sport }}</td>
            <td>{% set _ro = r.odds | default(r.parlay_odds | default(0)) | float %}{{ "{:.2f}".format(_ro) if _ro > 0 else "—" }}</td>
            <td>NT${{ "{:,.0f}".format(r.bet_amount | float) }}</td>
            <td>
              {% if r.result == "WIN" %}<span class="badge badge-win">WIN</span>
              {% elif r.result == "LOSS" %}<span class="badge badge-loss">LOSS</span>
              {% else %}<span class="badge badge-void">{{ r.result }}</span>{% endif %}
            </td>
            <td class="{% if r.pnl | float >= 0 %}green{% else %}red{% endif %}">
              {% if r.pnl | float >= 0 %}+{% endif %}NT${{ "{:,.0f}".format(r.pnl | float) }}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="summary-line">
      <span>投入 NT${{ "{:,.0f}".format(yesterday_total_bet) }} · 命中 {{ yesterday_wins }}/{{ yesterday_total }}</span>
      <strong class="{% if yesterday_pnl >= 0 %}green{% else %}red{% endif %}">
        {% if yesterday_pnl >= 0 %}+{% endif %}NT${{ "{:,.0f}".format(yesterday_pnl) }}
      </strong>
    </div>
    {% else %}
    <div class="panel empty">昨日沒有下注紀錄</div>
    {% endif %}
  </section>

  <section class="section">
    <div class="section-head">
      <h2>今日三策略下注</h2>
      <div class="hint">{{ report_date }}</div>
    </div>

    {% if strategies %}
    <div class="tabs">
      {% for st in strategies %}
      <button class="tab {% if loop.first %}active{% endif %}" onclick="switchTab({{ loop.index0 }}, this)">
        <span class="tab-name">{{ st.name }}</span>
        <span class="tab-sub">
          {% if st.no_picks %}今日空手{% else %}{{ st.parlays | length }} 組串關 · NT${{ "{:,.0f}".format(st.total) }}{% endif %}
        </span>
      </button>
      {% endfor %}
    </div>

    {% for st in strategies %}
    <div class="tab-panel {% if loop.first %}active{% endif %}" id="panel-{{ loop.index0 }}">
      <article class="strategy">
        <div class="strategy-summary">
          <div class="mini">
            <div class="mini-k">分析師本金</div>
            <div class="mini-v blue">NT${{ "{:,.0f}".format(st.bankroll_current) }}</div>
          </div>
          <div class="mini">
            <div class="mini-k">累積報酬率</div>
            <div class="mini-v {% if st.bankroll_roi >= 0 %}green{% else %}red{% endif %}">
              {% if st.bankroll_roi >= 0 %}+{% endif %}{{ "{:.1f}".format(st.bankroll_roi) }}%
            </div>
          </div>
          <div class="mini">
            <div class="mini-k">昨日命中</div>
            <div class="mini-v">{{ st.yesterday_wins }}/{{ st.yesterday_total }}</div>
          </div>
          <div class="mini">
            <div class="mini-k">今日下注</div>
            <div class="mini-v">NT${{ "{:,.0f}".format(st.total) }}</div>
          </div>
        </div>

        {% if st.no_picks %}
          <div class="empty">今日沒有符合門檻的串關</div>
          {% if st.required_5_leg_note %}
            <div class="empty">required_5_leg: {{ st.required_5_leg_note }}</div>
          {% endif %}
          {% if st.required_5_leg_candidates %}
            <div class="legs">
              {% for c in st.required_5_leg_candidates %}
              <div class="leg">
                <span><strong>{{ c.bet_label }}</strong> · {{ c.matchup }} · Edge {{ "{:+.1f}".format(c.edge * 100) }}%</span>
                <span>@{{ "{:.2f}".format(c.odds) }}</span>
              </div>
              {% endfor %}
            </div>
          {% endif %}
        {% else %}
          {% if st.required_5_leg_note %}
            <div class="empty">required_5_leg: {{ st.required_5_leg_note }}</div>
          {% endif %}
          {% if st.required_5_leg_candidates %}
            <div class="legs">
              {% for c in st.required_5_leg_candidates %}
              <div class="leg">
                <span><strong>{{ c.bet_label }}</strong> · {{ c.matchup }} · Edge {{ "{:+.1f}".format(c.edge * 100) }}%</span>
                <span>@{{ "{:.2f}".format(c.odds) }}</span>
              </div>
              {% endfor %}
            </div>
          {% endif %}
          <div class="parlay-grid">
          {% for p in st.parlays %}
            <div class="parlay">
              <div class="parlay-head">
                <div>
                  <div class="parlay-title">
                    {{ p.label }}
                    {% if p.fixed_bet | default(0) | float > 0 %}<span class="badge badge-info">保底 5 關</span>{% endif %}
                  </div>
                  <div class="parlay-meta">
                    {{ p.legs | length }} 關 · 總賠率 {{ "{:.2f}".format(p.parlay_odds) }} · EV {% if p.parlay_ev >= 0 %}+{% endif %}{{ "{:.1f}".format(p.parlay_ev * 100) }}%
                  </div>
                </div>
                <div>
                  <div class="amount">NT${{ "{:,.0f}".format(p.amount) }}</div>
                  <div class="potential">可贏 +NT${{ "{:,.0f}".format(p.potential) }}</div>
                </div>
              </div>
              <div class="legs">
                {% for leg in p.legs %}
                <div class="leg">
                  <span><strong>{{ leg.label }}</strong>{% if leg.matchup is defined %} · {{ leg.matchup }}{% endif %}</span>
                  <span>@{{ "{:.2f}".format(leg.odds) }}</span>
                </div>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
          </div>
          <div class="summary-line">
            <span>{{ st.parlays | length }} 組串關，單關 0 注</span>
            <strong class="blue">今日投入 NT${{ "{:,.0f}".format(st.total) }}</strong>
          </div>
        {% endif %}
      </article>
    </div>
    {% endfor %}
    {% else %}
      <div class="panel empty">今日計畫尚未產生</div>
    {% endif %}
  </section>

  <section class="section">
    <div class="section-head">
      <h2>台灣時間隔天賽程與比分預測</h2>
      <div class="hint">
        {% if next_day_predictions %}{{ next_day_predictions.target_date }} · {{ next_day_predictions.timezone }}{% else %}尚未產生{% endif %}
      </div>
    </div>
    {% if next_day_predictions and next_day_predictions.strategies %}
      <div class="hint">{{ next_day_predictions.source_note }}</div>
      <div class="prediction-grid" style="margin-top: 12px;">
      {% for st in next_day_predictions.strategies %}
        <article class="prediction-card">
          <div class="prediction-name">{{ st.name }} · {{ st.total_games }} 場</div>
          {% if st.games %}
            {% for g in st.games %}
            <div class="prediction-game">
              <div class="prediction-title">{{ g.sport }} · {{ g.matchup }}</div>
              <div class="prediction-score">{{ g.predicted_score }}</div>
              <div class="prediction-meta">
                {{ g.tw_time }} · 預測勝方 {{ g.predicted_winner }} · 信心 {{ g.confidence }}
                {% if g.home_starter or g.away_starter %}<br>先發：{{ g.away_starter or "TBD" }} / {{ g.home_starter or "TBD" }}{% endif %}
              </div>
            </div>
            {% endfor %}
          {% else %}
            <div class="empty">隔天暫無可預測賽程</div>
          {% endif %}
        </article>
      {% endfor %}
      </div>
    {% else %}
      <div class="panel empty">尚未取得隔天賽程，報表排程會在台灣時間 24:00 前更新。</div>
    {% endif %}
  </section>

  <footer>
    <a href="index.html">返回首頁</a><br>
    資料來源：NBA Stats API / MLB Stats API / Pinnacle 等效賠率。運彩有風險，請理性控管本金。
  </footer>
</main>

<script>
function switchTab(idx, btn) {
  document.querySelectorAll('.tab').forEach(item => item.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(item => item.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('panel-' + idx).classList.add('active');
}
</script>
</body>
</html>
